# Backend API (the backend/ workspace). When set, the app uses real per-user
# auth (register/login) and stores conversations/settings on the server instead
# of localStorage. Leave blank to stay fully local + use the soft gate below.
VITE_API_URL=http://localhost:8787

# Login gate. Used ONLY when VITE_API_URL is blank. Set both to require sign-in
# before the chat; leave either blank for open access. NOTE: Vite inlines these
# into the client bundle — this is a soft gate, not real security.
VITE_AUTH_USERNAME=admin
VITE_AUTH_PASSWORD=change-me

# Hermes OpenAI-compatible API base URL
VITE_HERMES_URL=http://localhost:8642

# Hermes API bearer token
VITE_HERMES_API_KEY=your-api-key-here

# Hermes model ID
VITE_HERMES_MODEL=hermes-agent

# Mock mode: stream a canned reply locally to test TTS + lip-sync without a
# running Hermes agent. Set to true to enable.
VITE_HERMES_MOCK=false

# Minimax TTS API base URL (endpoint /t2a_v2 appended automatically)
VITE_MINIMAX_BASE_URL=https://api.minimax.io/v1

# NOTE: Minimax API key + voice ID are now set in the in-app Settings dialog
# (persisted per-user), not here. These env vars still work as a fallback:
# VITE_MINIMAX_API_KEY=your-minimax-key-here
# VITE_MINIMAX_VOICE_ID=female-shaonv
