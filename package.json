{
  "name": "hermes-ai",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:web": "bun --filter @hermes/frontend dev",
    "dev:api": "bun --filter @hermes/backend dev",
    "build": "bun --filter @hermes/frontend build",
    "lint": "bun --filter @hermes/frontend lint",
    "start:api": "bun --filter @hermes/backend start"
  }
}
