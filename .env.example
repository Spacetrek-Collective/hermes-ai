# Hermes agent SSE chat endpoint (POST, streams text tokens)
VITE_HERMES_URL=http://localhost:8000/chat

# Live2D model entry (.model3.json). Default = bundled Haru sample.
VITE_MODEL_URL=/models/haru/haru_greeter_t03.model3.json

# TTS provider: edge (default) | minimax
VITE_TTS_PROVIDER=edge

# Edge TTS voice (https://github.com/rany2/edge-tts voices)
VITE_EDGE_TTS_VOICE=en-US-AvaNeural

# Optional proxy base if Edge TTS / Hermes are blocked by CORS in the browser
# VITE_TTS_PROXY=http://localhost:8000/tts
