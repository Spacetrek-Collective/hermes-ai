# Login gate. Set both to require sign-in before the chat. Leave either blank
# to disable the gate (open access). NOTE: Vite inlines these into the client
# bundle — this is a soft gate, not real security.
VITE_AUTH_USERNAME=admin
VITE_AUTH_PASSWORD=change-me

# Hermes OpenAI-compatible API base URL
VITE_HERMES_URL=http://localhost:8642

# Hermes API bearer token
VITE_HERMES_API_KEY=your-api-key-here

# Hermes model ID
VITE_HERMES_MODEL=hermes-agent

# Mock mode: stream a canned reply locally to test TTS + lip-sync without a
# running Hermes agent. Set to true to enable.
VITE_HERMES_MOCK=false
