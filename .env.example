# Root .env for docker-compose. Copy to .env and adjust.
# These feed compose interpolation (frontend build args + published ports).

# Public ports on the host
FRONTEND_PORT=8080
BACKEND_PORT=8787

# Browser-reachable backend URL (baked into the frontend bundle at build time)
VITE_API_URL=http://localhost:8787
# Frontend origin the backend allows via CORS — must match how you reach the UI
FRONTEND_ORIGIN=http://localhost:8080

# Backend JWT signing secret (required). Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend build args (Hermes chat API + TTS). Auth vars are the soft gate,
# only used when VITE_API_URL is blank.
VITE_HERMES_URL=https://api-hermes.sofyan.id
VITE_HERMES_API_KEY=
VITE_HERMES_MODEL=hermes-agent
VITE_HERMES_MOCK=false
VITE_MINIMAX_BASE_URL=https://api.minimax.io/v1
VITE_MINIMAX_API_KEY=
VITE_MINIMAX_VOICE_ID=female-shaonv

# Backend secrets live in backend/.env (JWT_SECRET, etc.)
