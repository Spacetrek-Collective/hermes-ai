# Hermes agent SSE chat endpoint (POST, streams text tokens)
VITE_HERMES_URL=http://localhost:8000/chat

# Mock mode: stream a canned reply locally to test TTS + lip-sync without a
# running Hermes agent. Set to true to enable.
VITE_HERMES_MOCK=true

# Live2D model entry (.model3.json). Default = bundled Haru sample.
VITE_MODEL_URL=/models/haru/haru_greeter_t03.model3.json

# TTS: Edge TTS via server proxy (/api/tts) — free, no key, real mp3 audio
# + lip-sync, works in every browser.

# Edge TTS voice (female by default). Other female voices:
#   en-US-JennyNeural, en-US-AvaNeural, en-GB-SoniaNeural, id-ID-GadisNeural, ja-JP-NanamiNeural
VITE_EDGE_TTS_VOICE=en-US-JennyNeural

# Production: point at your own /api/tts endpoint (the Vite middleware is dev-only)
# VITE_TTS_PROXY=https://your-server/api/tts

# Speech-to-text language (Web Speech API). Default = browser language.
# VITE_STT_LANG=id-ID

# Optional proxy base if Edge TTS / Hermes are blocked by CORS in the browser
# VITE_TTS_PROXY=http://localhost:8000/tts
